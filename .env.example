# Environment Variables for Nexus Dashboard
# Copy this to .env for local development, or set these in Vercel dashboard

# Prisma database URL (PostgreSQL)
# For local: use your local Postgres
# For Vercel: use Vercel Postgres, Neon, Supabase, etc.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexus-dashboard"

# NextAuth
NEXTAUTH_SECRET="nexus-dashboard-secret-key-change-in-production"
# NEXTAUTH_URL is auto-detected on Vercel via VERCEL_URL
# For local dev, set to your local URL:
NEXTAUTH_URL="http://localhost:3000"
